                             PPPOE-Server
.....................................................................

/ip firewall nat add chain=srcnat src-address=192.168.7.0/24 action=masquerade
/ip ppp profile 
add name=PPPOE-Server local-address=192.168.7.1 remote-address=PPPOE-Server dns-server=8.8.8.8,4.2.2.4
/ip profile
add name="PPPOE-Server" local-address=192.168.7.1 remote-address="IP Pool" dns-server="8.8.8.8,4.2.2.4" change-tcp-mss=default use-upnp=default
/ip pool 
add name=PPPOE-Server ranges=192.168.7.2-192.168.7.254
/ip ppp secrets
add name=admin password=admin service=pppoe profile=PPPOE-Server

/interface pppoe-server server
set service-name="PPPOE-Server" interface=ethernet1 max-mtu=1410 max-mru=1410 mrru=0 keepalive-timeout=10 default-profile="PPPOE-Server" one-session-per-host=yes authentication=mschap2



